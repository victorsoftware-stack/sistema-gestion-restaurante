# Puerto del servidor API local
PORT=3001

# Base de datos (SQLite local por defecto; en Vercel usar URL de Turso libsql://...)
DATABASE_URL=file:./sigr.db
TURSO_AUTH_TOKEN=

# Clave secreta para firmar tokens JWT de autenticación
JWT_SECRET=cambia-esta-clave-secreta-en-produccion

# URL base de la API consumida por el frontend Vite
VITE_API_URL=/api
